SECRET_KEY=  # Secret key for Django cryptographic signing

# Supabase
# Database
DATABASE_PASSWORD=  # Password for the PostgreSQL database
SUPABASE_URL=  # URL of the Supabase project
PUB_KEY=  # Public key for Supabase (anon key)
DIRECT_CON_STRING=  # Direct connection string to Supabase PostgreSQL

# pooler connection settings
HOST=  # Database host
PORT=  # Database port
DATABASE=  # Database name
USER=  # Database username
DATABASE_URL=  # Full database URL (overrides individual PG variables)

# Storage S3

ENDPOINT_URL=  # S3-compatible storage endpoint (e.g., Supabase storage)
REGION=  # AWS region for storage
ACCESS_KEY=  # S3 access key
STORAGE_SECRET_KEY=  # S3 secret key
BUCKET_NAME=  # Storage bucket name

#Email dev
EMAIL_HOST="sandbox.smtp.mailtrap.io"  # SMTP server hostname
EMAIL_PORT=587  # SMTP server port
EMAIL_HOST_USER=  # SMTP username
EMAIL_HOST_PASSWORD=   # SMTP password
EMAIL_USE_TLS=True  # Use TLS for SMTP (True/False)
EMAIL_USE_SSL=FALSE  # Use SSL for SMTP (True/False)

# Redis
# in docker
REDIS_URL=redis://redis:6379/1  # Redis connection URL